{
  "name": "agrolink",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "bash scripts/dev.sh",
    "dev:seed": "bash scripts/dev.sh --seed",
    "dev:reset": "bash scripts/dev.sh --reset",
    "build": "turbo run build",
    "build:db": "tsc -p packages/database/tsconfig.json",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "cd packages/database && npx drizzle-kit generate",
    "db:migrate": "cd packages/database && npx drizzle-kit migrate",
    "seed": "npx tsx apps/api/src/lib/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "npmrc": "legacy-peer-deps=true"
}
